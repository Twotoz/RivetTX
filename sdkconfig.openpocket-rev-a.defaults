# OpenPocket Revision-A authoritative ESP32-S3-MINI-1U-N8 allocation.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.openpocket-rev-a.csv"
# CONFIG_SPIRAM is not set

CONFIG_RIVETTX_OPENPOCKET_OSD=y
CONFIG_RIVETTX_OPENPOCKET_REV_A=y
CONFIG_RIVETTX_AT7456E_SCLK_GPIO=11
CONFIG_RIVETTX_AT7456E_MOSI_GPIO=12
CONFIG_RIVETTX_AT7456E_MISO_GPIO=13
CONFIG_RIVETTX_AT7456E_CS_GPIO=14
CONFIG_RIVETTX_AT7456E_RESET_GPIO=21

CONFIG_RIVETTX_RX5808_ENABLED=y
CONFIG_RIVETTX_RX5808_DATA_GPIO=7
CONFIG_RIVETTX_RX5808_LE_GPIO=8
CONFIG_RIVETTX_RX5808_CLK_GPIO=9
CONFIG_RIVETTX_RX5808_RSSI_GPIO=5

CONFIG_RIVETTX_CRSF_TX=17
CONFIG_RIVETTX_CRSF_RX=18
CONFIG_RIVETTX_AXIS0_GPIO=1
CONFIG_RIVETTX_AXIS1_GPIO=2
CONFIG_RIVETTX_AXIS2_GPIO=3
CONFIG_RIVETTX_AXIS3_GPIO=4
CONFIG_RIVETTX_AXIS4_GPIO=-1
CONFIG_RIVETTX_AXIS5_GPIO=-1
CONFIG_RIVETTX_AXIS6_GPIO=-1
CONFIG_RIVETTX_AXIS7_GPIO=-1

# Slow buttons, switches and trims use the two onboard TCA9535 expanders.
CONFIG_RIVETTX_BUTTON_UP=-1
CONFIG_RIVETTX_BUTTON_DOWN=-1
CONFIG_RIVETTX_BUTTON_ENTER=-1
CONFIG_RIVETTX_BUTTON_BACK=-1
CONFIG_RIVETTX_AUX1_GPIO=-1
CONFIG_RIVETTX_AUX2_GPIO=-1
CONFIG_RIVETTX_AUX3_GPIO=-1
CONFIG_RIVETTX_AUX4_GPIO=-1
CONFIG_RIVETTX_AUX2_LOW_GPIO=-1
CONFIG_RIVETTX_AUX3_LOW_GPIO=-1
CONFIG_RIVETTX_AUX4_LOW_GPIO=-1
CONFIG_RIVETTX_ENCODER_A_GPIO=-1
CONFIG_RIVETTX_ENCODER_B_GPIO=-1
CONFIG_RIVETTX_ENCODER_PRESS_GPIO=-1
CONFIG_RIVETTX_TRIM_AIL_NEG_GPIO=-1
CONFIG_RIVETTX_TRIM_AIL_POS_GPIO=-1
CONFIG_RIVETTX_TRIM_ELE_NEG_GPIO=-1
CONFIG_RIVETTX_TRIM_ELE_POS_GPIO=-1
CONFIG_RIVETTX_TRIM_THR_NEG_GPIO=-1
CONFIG_RIVETTX_TRIM_THR_POS_GPIO=-1
CONFIG_RIVETTX_TRIM_RUD_NEG_GPIO=-1
CONFIG_RIVETTX_TRIM_RUD_POS_GPIO=-1
CONFIG_RIVETTX_BATTERY_GPIO=-1
CONFIG_RIVETTX_BUZZER_GPIO=35

CONFIG_RIVETTX_BOARD_I2C_SDA_GPIO=15
CONFIG_RIVETTX_BOARD_I2C_SCL_GPIO=16
CONFIG_RIVETTX_CONTROL_EXPANDER_INT_GPIO=10
CONFIG_RIVETTX_DISPLAY_CONTROLLER_RESET_GPIO=38
CONFIG_RIVETTX_AMT630A_I2C_ADDRESS=0x58
CONFIG_RIVETTX_AMT630A_FLASH_TIMEOUT_MS=10000
CONFIG_RIVETTX_AMT630A_FLASH_CS_GPIO=26
CONFIG_RIVETTX_AMT630A_FLASH_CLK_GPIO=33
CONFIG_RIVETTX_AMT630A_FLASH_MOSI_GPIO=34
CONFIG_RIVETTX_AMT630A_FLASH_MUX_GPIO=36
CONFIG_RIVETTX_AMT630A_FLASH_MISO_GPIO=37
CONFIG_RIVETTX_SPEAKER_I2S_BCLK_GPIO=39
CONFIG_RIVETTX_SPEAKER_I2S_WS_GPIO=45
CONFIG_RIVETTX_SPEAKER_I2S_DATA_GPIO=46
CONFIG_RIVETTX_SPEAKER_ENABLE_GPIO=6
CONFIG_RIVETTX_5V_VIDEO_ENABLE_GPIO=40
CONFIG_RIVETTX_5V_DISPLAY_ENABLE_GPIO=41
CONFIG_RIVETTX_5V_ELRS_ENABLE_GPIO=42
CONFIG_RIVETTX_CHARGER_INT_GPIO=43
CONFIG_RIVETTX_FUEL_GAUGE_ALERT_GPIO=44
CONFIG_RIVETTX_BACKLIGHT_PWM_GPIO=47
CONFIG_RIVETTX_VBUS_DETECT_GPIO=48

CONFIG_TINYUSB_HID_COUNT=1
