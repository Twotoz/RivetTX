    range 16 31
    default 22
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SD_POWER_EXPANDER_BIT
    int "3V3_SD load-switch enable expander bit"
    range 16 31
    default 23
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SD_INITIAL_CLOCK_KHZ
    int "Initial SD identification clock (kHz)"
