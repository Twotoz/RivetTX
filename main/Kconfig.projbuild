menu "RivetTX hardware"

config RIVETTX_OPENPOCKET_OSD
    bool "Use OpenPocket AT7456E analog OSD instead of SSD1306"
    default n
    help
        Select exactly one presentation owner. When enabled, RivetTX uses
        the 30x16 OpenPocket character compositor and AT7456E video overlay;
        it does not initialize the SSD1306 OLED.

config RIVETTX_AT7456E_SCLK_GPIO
    int "AT7456E SPI clock GPIO"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_MOSI_GPIO
    int "AT7456E SPI MOSI / SDIN GPIO"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_MISO_GPIO
    int "AT7456E SPI MISO / SDOUT GPIO"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_CS_GPIO
    int "AT7456E active-low chip-select GPIO"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_RESET_GPIO
    int "AT7456E active-low reset GPIO (-1 uses software reset)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_SPI_CLOCK_HZ
    int "AT7456E SPI clock (Hz)"
    range 100000 10000000
    default 8000000
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_CS_SETUP_CYCLES
    int "AT7456E CS setup time (SPI clock cycles)"
    range 1 16
    default 1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_AT7456E_CS_HOLD_CYCLES
    int "AT7456E CS hold time (SPI clock cycles)"
    range 1 16
    default 1
    depends on RIVETTX_OPENPOCKET_OSD

config RIVETTX_I2C_SDA
    int "OLED I2C SDA GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 4 if IDF_TARGET_ESP32C3
    default 8 if IDF_TARGET_ESP32S3

config RIVETTX_I2C_SCL
    int "OLED I2C SCL GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 5 if IDF_TARGET_ESP32C3
    default 9 if IDF_TARGET_ESP32S3

config RIVETTX_OLED_ADDRESS
    hex "OLED I2C address"
    default 0x3C

config RIVETTX_CRSF_TX
    int "CRSF UART TX GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 6 if IDF_TARGET_ESP32C3
    default 17 if IDF_TARGET_ESP32S3

config RIVETTX_CRSF_RX
    int "CRSF UART RX GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 7 if IDF_TARGET_ESP32C3
    default 18 if IDF_TARGET_ESP32S3

config RIVETTX_AXIS0_GPIO
    int "Axis 0 ADC GPIO"
    range 0 4 if IDF_TARGET_ESP32C3
    range 1 10 if IDF_TARGET_ESP32S3
    default 0 if IDF_TARGET_ESP32C3
    default 1 if IDF_TARGET_ESP32S3

config RIVETTX_AXIS1_GPIO
    int "Axis 1 ADC GPIO"
    range 0 4 if IDF_TARGET_ESP32C3
    range 1 10 if IDF_TARGET_ESP32S3
    default 1 if IDF_TARGET_ESP32C3
    default 2 if IDF_TARGET_ESP32S3

config RIVETTX_AXIS2_GPIO
    int "Axis 2 ADC GPIO"
    range 0 4 if IDF_TARGET_ESP32C3
    range 1 10 if IDF_TARGET_ESP32S3
    default 2 if IDF_TARGET_ESP32C3
    default 3 if IDF_TARGET_ESP32S3

config RIVETTX_AXIS3_GPIO
    int "Axis 3 ADC GPIO"
    range 0 4 if IDF_TARGET_ESP32C3
    range 1 10 if IDF_TARGET_ESP32S3
    default 3 if IDF_TARGET_ESP32C3
    default 4 if IDF_TARGET_ESP32S3

config RIVETTX_AXIS4_GPIO
    int "Axis 4 / left scroll wheel ADC GPIO (-1 disables)"
    range -1 4 if IDF_TARGET_ESP32C3
    range -1 10 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_AXIS5_GPIO
    int "Axis 5 / right scroll wheel ADC GPIO (-1 disables)"
    range -1 4 if IDF_TARGET_ESP32C3
    range -1 10 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_AXIS6_GPIO
    int "Axis 6 / pot or slider ADC GPIO (-1 disables)"
    range -1 4 if IDF_TARGET_ESP32C3
    range -1 10 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_AXIS7_GPIO
    int "Axis 7 / pot or slider ADC GPIO (-1 disables)"
    range -1 4 if IDF_TARGET_ESP32C3
    range -1 10 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_BUTTON_UP
    int "Up button GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 8 if IDF_TARGET_ESP32C3
    default 10 if IDF_TARGET_ESP32S3

config RIVETTX_BUTTON_DOWN
    int "Down button GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 9 if IDF_TARGET_ESP32C3
    default 11 if IDF_TARGET_ESP32S3

config RIVETTX_BUTTON_ENTER
    int "Enter button GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 10 if IDF_TARGET_ESP32C3
    default 12 if IDF_TARGET_ESP32S3

config RIVETTX_BUTTON_BACK
    int "Back/recovery button GPIO"
    range 0 21 if IDF_TARGET_ESP32C3
    range 0 48 if IDF_TARGET_ESP32S3
    default 20 if IDF_TARGET_ESP32C3
    default 14 if IDF_TARGET_ESP32S3

config RIVETTX_AUX1_GPIO
    int "AUX1 / Betaflight ARM switch GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    help
        Connect a maintained two-position switch between this GPIO and
        ground. The input uses the internal pull-up, is active low, and the
        default model sends it on CH5/AUX1. Leave disabled until the board
        has a dedicated arming switch.

config RIVETTX_AUX2_GPIO
    int "AUX2 / Betaflight PREARM switch GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    help
        Active-low maintained switch sent on CH6/AUX2 by the default model.

config RIVETTX_AUX3_GPIO
    int "AUX3 / Betaflight mode switch GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    help
        Active-low maintained switch sent on CH7/AUX3 by the default model.

config RIVETTX_AUX4_GPIO
    int "AUX4 / Betaflight beeper switch GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    help
        Active-low maintained switch sent on CH8/AUX4 by the default model.

config RIVETTX_AUX2_LOW_GPIO
    int "AUX2 three-position LOW contact GPIO (-1 uses two-position)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1
    help
        When configured together with AUX2 GPIO, LOW active gives -100%,
        neither contact gives center, and AUX2 active gives +100%.

config RIVETTX_AUX3_LOW_GPIO
    int "AUX3 three-position LOW contact GPIO (-1 uses two-position)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_AUX4_LOW_GPIO
    int "AUX4 three-position LOW contact GPIO (-1 uses two-position)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_ENCODER_A_GPIO
    int "Menu rotary encoder A GPIO (-1 disables encoder)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_ENCODER_B_GPIO
    int "Menu rotary encoder B GPIO (-1 disables encoder)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_ENCODER_PRESS_GPIO
    int "Menu rotary encoder press GPIO (-1 disables press)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_AIL_NEG_GPIO
    int "Aileron trim left GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_AIL_POS_GPIO
    int "Aileron trim right GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_ELE_NEG_GPIO
    int "Elevator trim down GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_ELE_POS_GPIO
    int "Elevator trim up GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_THR_NEG_GPIO
    int "Throttle trim down GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_THR_POS_GPIO
    int "Throttle trim up GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_RUD_NEG_GPIO
    int "Rudder trim left GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_TRIM_RUD_POS_GPIO
    int "Rudder trim right GPIO (-1 disables)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_BATTERY_GPIO
    int "Battery ADC GPIO (-1 disables battery sensing)"
    range -1 4 if IDF_TARGET_ESP32C3
    range -1 10 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_BATTERY_DIVIDER_MILLI
    int "Battery divider multiplier x1000"
    range 1000 10000
    default 2000

config RIVETTX_BATTERY_LOW_MV
    int "Transmitter battery low warning (mV)"
    range 1100 30000
    default 3500
    help
        Set this for the complete transmitter battery pack. It must be
        higher than the critical threshold.

config RIVETTX_BATTERY_CRITICAL_MV
    int "Transmitter battery critical warning (mV)"
    range 1000 30000
    default 3200
    help
        At or below this voltage RivetTX locks outputs as well as playing
        the critical battery pattern.

config RIVETTX_BUZZER_GPIO
    int "Passive piezo buzzer GPIO (-1 disables audio)"
    range -1 21 if IDF_TARGET_ESP32C3
    range -1 48 if IDF_TARGET_ESP32S3
    default -1

config RIVETTX_BUZZER_VOLUME
    int "Passive piezo duty percentage"
    range 1 50
    default 25

config RIVETTX_LINK_WARNING_LQ
    int "ELRS weak-link warning threshold (LQ percent)"
    range 2 100
    default 70

config RIVETTX_LINK_CRITICAL_LQ
    int "ELRS critical-link warning threshold (LQ percent)"
    range 1 99
    default 30
    help
        Keep this lower than the weak-link threshold. Warnings use
        hysteresis and repeat faster as the link becomes critical.

config RIVETTX_WIFI_BACKUP
    bool "Enable maintenance Wi-Fi backup portal"
    default y

config RIVETTX_WIFI_PASSWORD
    string "Maintenance AP password"
    default "change-rivettx"
    depends on RIVETTX_WIFI_BACKUP

endmenu
