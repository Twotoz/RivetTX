menu "RivetTX hardware"

config RIVETTX_OPENPOCKET_OSD
    bool "Use OpenPocket AT7456E analog OSD instead of SSD1306"
    default n
    help
        Select exactly one presentation owner. When enabled, RivetTX uses
        the 30x16 OpenPocket character compositor and AT7456E video overlay;
        it does not initialize the SSD1306 OLED.

config RIVETTX_OPENPOCKET_REV_A
    bool "OpenPocket Revision-A integrated ESP32-S3 board"
    default n
    depends on IDF_TARGET_ESP32S3 && RIVETTX_OPENPOCKET_OSD
    help
        Enables the integrated charger, MAX17048 gauge, three switched 5 V
        domains, AMT630A status and direct flash recovery, backlight PWM,
        non-blocking buzzer/I2S audio, and two I2C control
        expanders. Revision A uses native USB and requires no PSRAM.

config RIVETTX_BOARD_I2C_SDA_GPIO
    int "Revision-A board I2C SDA GPIO"
    range 0 48
    default 15
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_BOARD_I2C_SCL_GPIO
    int "Revision-A board I2C SCL GPIO"
    range 0 48
    default 16
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_5V_VIDEO_ENABLE_EXPANDER_BIT
    int "5V_VIDEO load-switch enable expander bit"
    range 16 31
    default 24
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_5V_DISPLAY_ENABLE_EXPANDER_BIT
    int "5V_DISPLAY load-switch enable expander bit"
    range 16 31
    default 25
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_5V_ELRS_ENABLE_EXPANDER_BIT
    int "5V_ELRS load-switch enable expander bit"
    range 16 31
    default 26
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SDMMC_ENABLED
    bool "OpenPocket removable microSD storage"
    default y
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SD_CLK_GPIO
    int "SDMMC 1-bit CLK GPIO"
    range 0 48
    default 40
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SD_CMD_GPIO
    int "SDMMC 1-bit CMD GPIO"
    range 0 48
    default 41
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_SD_D0_GPIO
    int "SDMMC 1-bit DAT0 GPIO"
