    default 20000
    depends on RIVETTX_SDMMC_ENABLED

config RIVETTX_SD_DETECT_DEBOUNCE_MS
    int "microSD card-detect debounce (milliseconds)"
    range 20 500
    default 80
    depends on RIVETTX_SDMMC_ENABLED

config RIVETTX_BACKLIGHT_PWM_GPIO
    int "TPS61165 backlight PWM GPIO"
    range 0 48
    default 47
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_BACKLIGHT_DEFAULT_PERCENT
    int "Default TFT backlight percentage"
    range 0 100
    default 60
    depends on RIVETTX_OPENPOCKET_REV_A

config RIVETTX_DISPLAY_CONTROLLER_RESET_GPIO
    int "AMT630A active-low reset GPIO"
    range 0 48
