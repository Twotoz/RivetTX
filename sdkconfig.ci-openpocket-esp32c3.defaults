# Compile-only CI allocation. This is not a production OpenPocket pinout.
CONFIG_RIVETTX_OPENPOCKET_OSD=y
CONFIG_RIVETTX_AT7456E_SCLK_GPIO=5
CONFIG_RIVETTX_AT7456E_MOSI_GPIO=11
CONFIG_RIVETTX_AT7456E_MISO_GPIO=18
CONFIG_RIVETTX_AT7456E_CS_GPIO=19
CONFIG_RIVETTX_AT7456E_RESET_GPIO=-1
CONFIG_RIVETTX_RX5808_ENABLED=y
CONFIG_RIVETTX_RX5808_DATA_GPIO=12
CONFIG_RIVETTX_RX5808_CLK_GPIO=13
CONFIG_RIVETTX_RX5808_LE_GPIO=14
CONFIG_RIVETTX_RX5808_RSSI_GPIO=4
