# Compile-only CI allocation. This is not a production OpenPocket pinout.
CONFIG_RIVETTX_OPENPOCKET_OSD=y
CONFIG_RIVETTX_AT7456E_SCLK_GPIO=40
CONFIG_RIVETTX_AT7456E_MOSI_GPIO=41
CONFIG_RIVETTX_AT7456E_MISO_GPIO=42
CONFIG_RIVETTX_AT7456E_CS_GPIO=43
