CONFIG_RIVETTX_RX5808_ENABLED=y
CONFIG_RIVETTX_RX5808_DATA_GPIO=45
CONFIG_RIVETTX_RX5808_CLK_GPIO=47
CONFIG_RIVETTX_RX5808_LE_GPIO=48
CONFIG_RIVETTX_RX5808_RSSI_GPIO=5
